# Cedi Soft website — variabili proprie, mai condivise con cedi-platform.
# Tutte NEXT_PUBLIC_*: finiscono nel browser. NESSUN segreto in questo progetto.

# Origine pubblica di questo sito (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Origine della Cedi Platform (identity surface con /login). Solo l'origine, nessun path.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
# In produzione: https://platform.cedisoft.it

# Origine dell'API pubblica di Cedi Platform (richieste dal sito, news, changelog).
# Vuota = integrazione spenta. La Platform deve elencare l'origine di questo sito in
# CediPlatform:PublicSite:AllowedOrigins (CORS del modulo richieste). Dominio di produzione: da decidere.
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:5171
# Live Chat: identificativo del sito registrato nella Platform (vuoto = nessuna chat) e, se diverso dall'API, l'origine del widget.
NEXT_PUBLIC_CHAT_SITE_KEY=
NEXT_PUBLIC_CHAT_URL=

# Solo sviluppo/anteprima Vercel: abilita le simulazioni di Cedi Assist (IA e operatore finti). NON in produzione.
NEXT_PUBLIC_ASSIST_DEMO=1
